# Where the FastAPI backend runs. Open the site at http://localhost:3000 (not 127.0.0.1),
# because the backend only allows that origin by default (ALLOWED_ORIGINS in its .env).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production (Vercel > Settings > Environment Variables): set NEXT_PUBLIC_API_URL to the deployed
# backend, e.g. https://api.example.com. It is baked in at build time, and a Production build
# fails if it is missing, not https, or points at localhost.
