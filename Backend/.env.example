DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
GEMINI_API_KEY=
# Comma-separated list (or a JSON list) of frontend URLs allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# --- Production (set these in the Vercel dashboard, not in a file) ---
# TRUST_FORWARDED_FOR=true          # only on Vercel: lets the rate limiter see the real visitor IP
# ALLOWED_ORIGIN_REGEX=https://your-project-.*\.vercel\.app    # optional: preview deployments

# Optional: these have working defaults. Override only if answers start failing
# (run `python -m scripts.try_models` to see which models work for your key).
# GENERATION_MODEL=gemini-3.5-flash-lite
# GENERATION_FALLBACK_MODELS=gemini-3.6-flash
