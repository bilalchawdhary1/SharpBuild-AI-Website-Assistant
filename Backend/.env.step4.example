# Add only what you use. With none of these set, leads just stay in the database.
LEAD_WEBHOOK_URL=https://your-crm-or-zapier-hook.example/...   # must be https
LEAD_WEBHOOK_SECRET=generate-a-long-random-string               # signs every request
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
LEAD_EMAIL_FROM=assistant@sharpbuild.io
LEAD_EMAIL_TO=sales@sharpbuild.io
ADMIN_TOKEN=generate-another-long-random-string                 # protects /internal/retry-lead-notifications
