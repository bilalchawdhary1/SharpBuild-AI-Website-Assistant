# Production hardening (set in Vercel / your host, not in the repo)
RATE_LIMIT_BACKEND=database      # shared counters across serverless instances (run scripts.init_db once first)
ENABLE_DOCS=false                # hide /docs, /redoc, /openapi.json
ADMIN_TOKEN=                     # 32+ random characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
TRUST_FORWARDED_FOR=true         # only on Vercel/behind a proxy that overwrites X-Forwarded-For
# Optional tuning: MAX_BODY_BYTES=32768  LEAD_GLOBAL_RATE_LIMIT_PER_MINUTE=30  ADMIN_RATE_LIMIT_PER_MINUTE=30
